.map-wrap { display: flex; flex-direction: column; height: 100vh; }
.map { flex: 1; width: 100%; }
.panel {
  padding: 16rpx 24rpx 28rpx;
  background: var(--panel);
  border-top: 1rpx solid var(--line);
}
.picked { font-size: 28rpx; color: var(--gold); font-weight: 600; }
.coord-row { display: flex; gap: 16rpx; margin-top: 12rpx; }
.coord-field { flex: 1; }
.preset-row { margin-top: 12rpx; }
.preset-btn {
  background: var(--panel-2);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  font-size: 26rpx;
  color: var(--text);
}
.coord-btns { display: flex; gap: 16rpx; margin-top: 16rpx; }
