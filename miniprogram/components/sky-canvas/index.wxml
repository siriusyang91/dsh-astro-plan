<view class="sky {{fullscreen ? 'full zoom-in' : ''}} {{justExited ? 'zoom-out' : ''}}">
  <canvas
    id="sky"
    type="2d"
    class="cv {{fullscreen ? 'cv-full' : ''}}"
    bindtouchstart="onTouchStart"
    catchtouchmove="onTouchMove"
    bindtouchend="stop"
    bindtap="onTap"
  ></canvas>

  <!-- 全屏：底部信息区（高度角 / 赤经赤纬 / 地点 / 最佳时段） -->
  <view wx:if="{{fullscreen}}" class="fs-info-bottom">
    <text class="fs-line">{{hud.time}}</text>
    <text class="fs-line">{{hud.window}}</text>
    <text class="fs-line" wx:if="{{hud.altaz}}">{{hud.altaz}}</text>
    <text class="fs-line" wx:if="{{hud.radec}}">{{hud.radec}}</text>
    <text class="fs-line">{{hud.fov}}</text>
  </view>

  <!-- 全屏：底部操作栏（播放 + 进度条） -->
  <view wx:if="{{fullscreen}}" class="fs-bottom">
    <view class="fs-row">
      <view class="key" bindtap="togglePlay">{{playing ? '暂停' : '播放'}}</view>
      <slider style="flex:1" min="0" max="{{maxK}}" value="{{k}}" block-size="14" bindchanging="onSlide" bindchange="onSlide" activeColor="#2f66c9" />
      <view class="frame">{{k}}/{{maxK}}</view>
      <view class="key {{trackerOn ? 'on' : ''}} {{flipping === 'track' ? 'flipping' : ''}}" bindtap="toggleTracker">跟踪 {{trackerOn ? '开' : '关'}}</view>
    </view>
    <view class="fs-row">
      <view class="key {{flipping === 'mode' ? 'flipping' : ''}}" bindtap="toggleMode">{{hud.modeLabel}}</view>
      <view class="key {{constellationOn ? 'on' : ''}} {{flipping === 'const' ? 'flipping' : ''}}" bindtap="toggleConstellations">星座名 {{constellationOn ? '开' : '关'}}</view>
      <view class="key" bindtap="reset">复位视角</view>
      <view class="key" bindtap="toggleFullscreen">退出全屏</view>
    </view>
  </view>

  <block wx:if="{{!fullscreen}}">
    <view class="tip">拖动转视角（左右转向 / 上下俯仰）· 双指缩放 · 双击全屏</view>
    <view class="ctrl">
      <view class="play" bindtap="togglePlay">{{playing ? '暂停' : '播放'}}</view>
      <slider style="flex:1" min="0" max="{{maxK}}" value="{{k}}" block-size="14" bindchanging="onSlide" bindchange="onSlide" activeColor="#2f66c9" />
      <view class="frame">{{k}}/{{maxK}}</view>
      <view class="key {{trackerOn ? 'on' : ''}} {{flipping === 'track' ? 'flipping' : ''}}" bindtap="toggleTracker">跟踪 {{trackerOn ? '开' : '关'}}</view>
    </view>
    <view class="ctrl">
      <view class="key {{flipping === 'mode' ? 'flipping' : ''}}" bindtap="toggleMode">{{hud.modeLabel}}</view>
      <view class="key {{constellationOn ? 'on' : ''}} {{flipping === 'const' ? 'flipping' : ''}}" bindtap="toggleConstellations">星座名 {{constellationOn ? '开' : '关'}}</view>
      <view class="key" bindtap="reset">复位视角</view>
      <view class="key" bindtap="toggleFullscreen">全屏显示</view>
      <view class="fov">视野 {{fovText}}</view>
    </view>
  </block>
</view>
