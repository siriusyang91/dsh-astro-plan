/* 查询页：完整字段 + 压缩间距（一屏尽量放下） */
.wrap { padding: 12rpx 18rpx 28rpx; }
.hero { padding: 0 4rpx 8rpx; }
.hero-title { font-size: 36rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-sub { font-size: 22rpx; color: var(--dim); }
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; }
.actions { display: flex; gap: 12rpx; margin-top: 12rpx; }
.actions .btn { padding: 16rpx 0; font-size: 28rpx; }
.hint.tiny { font-size: 20rpx; margin-top: 6rpx; }
.card { padding: 12rpx 16rpx; margin-bottom: 10rpx; }
.card-title { font-size: 26rpx; margin-bottom: 6rpx; }
.label { font-size: 22rpx; margin-top: 8rpx; margin-bottom: 4rpx; }
.picker-value { padding: 10rpx 12rpx; font-size: 26rpx; }
.row { padding: 4rpx 0; }
.row-key { font-size: 24rpx; }
picker { display: block; }
.btn-ghost { padding: 10rpx 0; font-size: 24rpx; }
