<!-- 便签：底部半屏弹层（对应网页版便签浮窗） -->
<view wx:if="{{visible}}" class="mask" bindtap="onClose" catchtouchmove="noop">
  <view class="sheet" catchtap="noop">
    <view class="sheet-head">
      <view class="sheet-title">{{title}}</view>
      <view class="sheet-close" bindtap="onClose">关闭</view>
    </view>

    <scroll-view scroll-y class="sheet-body">
      <!-- 画面模拟（懒加载：打开便签才请求云函数） -->
      <view class="sec">
        <view class="sec-title">画面模拟（最佳时段）</view>
        <block wx:if="{{sim && sim.frames && sim.frames.length}}">
          <sky-canvas sim="{{sim}}" sky="{{sky}}" mode="{{mode}}" />
          <view class="mode-row">
            <view class="chip {{mode === 'altaz' ? 'on' : ''}}" data-mode="altaz" bindtap="switchMode">地平坐标</view>
            <view class="chip {{mode === 'eq' ? 'on' : ''}}" data-mode="eq" bindtap="switchMode">赤道坐标</view>
          </view>
        </block>
        <view wx:elif="{{simLoading}}" class="hint">正在生成画面模拟…（约 1–3 秒）</view>
        <view wx:elif="{{simError}}" class="hint warn">{{simError}}</view>
        <view wx:elif="{{sim && sim.skip}}" class="hint">该题材暂不支持 3D 画面模拟</view>
        <view wx:else class="hint">展开后自动加载</view>
      </view>

      <view wx:for="{{sections}}" wx:key="title" class="sec">
        <view class="sec-title">{{item.title}}</view>
        <view wx:for="{{item.rows}}" wx:for-item="row" wx:key="*this" class="row">
          <view class="row-key">{{row[0]}}</view>
          <view class="row-val">{{row[1]}}</view>
        </view>
      </view>

      <view wx:if="{{reasons.length}}" class="sec">
        <view class="sec-title">推荐理由</view>
        <view wx:for="{{reasons}}" wx:key="*this" class="reason">· {{item}}</view>
      </view>
    </scroll-view>
  </view>
</view>
