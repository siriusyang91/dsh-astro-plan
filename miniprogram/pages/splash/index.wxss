.splash {
  position: fixed; top: 0; right: 0; bottom: 0; left: 0;
  background: #05070d; overflow: hidden;
}
.bg { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.veil {
  position: absolute; top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(180deg, rgba(5, 7, 13, .15) 0%, rgba(5, 7, 13, .55) 55%, rgba(5, 7, 13, .92) 100%);
}
.stage {
  position: absolute; left: 0; right: 0; bottom: 18vh;
  display: flex; flex-direction: column; align-items: center;
  animation: rise 700ms ease-out both;
}
.title {
  font-size: 64rpx; font-weight: 700; letter-spacing: 8rpx; color: #f2f6ff;
  text-shadow: 0 6rpx 30rpx rgba(0, 0, 0, .6);
}
.title-line { display: flex; align-items: baseline; gap: 12rpx; }
.sub { font-size: 26rpx; color: rgba(223, 231, 245, .8); letter-spacing: 4rpx; }
.welcome {
  margin-top: 40rpx; padding: 14rpx 34rpx; border-radius: 999rpx;
  border: 1rpx solid rgba(255, 212, 121, .55);
  background: rgba(8, 12, 20, .45);
  color: #ffd479; font-size: 30rpx; letter-spacing: 3rpx;
  animation: fade 900ms ease-out 120ms both;
}
@keyframes rise {
  from { transform: translateY(26rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
@keyframes fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
