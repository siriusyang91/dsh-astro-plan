.mask {
  position: fixed; inset: 0; background: rgba(0, 0, 0, .6);
  display: flex; align-items: flex-end; z-index: 100;
}
.sheet {
  width: 100%; max-height: 84vh; background: var(--panel);
  border-radius: 24rpx 24rpx 0 0; border-top: 1rpx solid var(--line);
  display: flex; flex-direction: column;
}
.sheet-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 24rpx; border-bottom: 1rpx solid var(--line);
}
.sheet-title { font-size: 30rpx; font-weight: 600; flex: 1; }
.sheet-close { color: var(--dim); font-size: 26rpx; padding: 8rpx 16rpx; }
.sheet-body { flex: 1; padding: 10rpx 24rpx 40rpx; }
.sec { margin-top: 20rpx; }
.sec-title { font-size: 26rpx; color: var(--gold); margin-bottom: 6rpx; }
.reason { color: var(--dim); font-size: 24rpx; line-height: 1.7; }
