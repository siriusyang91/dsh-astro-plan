.sky { width: 100%; }
.sky.full {
  position: fixed; top: 0; right: 0; bottom: 0; left: 0;
  z-index: 900; background: #03050a;
  display: flex; align-items: center; justify-content: center;
}
.cv { width: 100%; height: 360rpx; display: block; border-radius: 12rpx; background: #03050a; }
.cv-full { width: 100%; height: 100%; border-radius: 0; }
.float-exit {
  position: absolute; top: 24rpx; right: 24rpx;
  padding: 10rpx 22rpx; border-radius: 999rpx;
  background: rgba(20, 28, 44, .85); color: #dfe7f5; font-size: 24rpx;
  border: 1rpx solid #26364f;
}
.tip { margin-top: 8rpx; color: var(--dim); font-size: 22rpx; }
.ctrl { display: flex; align-items: center; gap: 10rpx; margin-top: 8rpx; flex-wrap: wrap; }
.play, .key {
  padding: 8rpx 18rpx; border-radius: 999rpx; border: 1rpx solid var(--line);
  background: var(--panel-2); font-size: 22rpx; color: var(--text);
}
.frame { color: var(--dim); font-size: 22rpx; width: 80rpx; text-align: right; }
.fov { color: var(--dim); font-size: 22rpx; margin-left: auto; }
