<view class="wrap">
  <view wx:if="{{loading}}" class="hint">正在加载站点库…</view>
  <view wx:elif="{{error}}" class="card">
    <view class="card-title warn">加载失败</view>
    <view class="hint">{{error}}</view>
    <view class="hint">请确认已在 app.js 填入云开发环境 ID，并已上传 astroPlan 云函数。</view>
  </view>

  <block wx:else>
    <view class="hero">
      <view class="hero-line">
        <text class="hero-title">星野计划</text>
        <text class="hero-sub">by Sirius YANG</text>
      </view>
    </view>

    <!-- 1. 拍摄目标（置顶） -->
    <view class="card card-target">
      <view class="card-title">拍摄目标</view>

      <view class="frow">
        <text class="flabel">目标</text>
        <picker mode="multiSelector" range="{{targetColumns}}" value="{{targetIndex}}" bindcolumnchange="onTargetColumnChange" bindchange="onTargetChange">
          <view class="fv">{{targetLabel}}</view>
        </picker>
      </view>

      <view class="frow">
        <text class="flabel">高度角≥{{minAlt}}°</text>
        <slider class="sl" min="0" max="60" step="5" value="{{minAlt}}" block-size="14" show-value="{{false}}" bindchanging="onAltChanging" bindchange="onAlt" activeColor="#2f66c9" />
      </view>
      <view class="frow">
        <text class="flabel">波特尔≤B{{bortle}}</text>
        <slider class="sl" min="1" max="9" step="1" value="{{bortle}}" block-size="14" show-value="{{false}}" bindchanging="onBortleChanging" bindchange="onBortle" activeColor="#2f66c9" />
      </view>
    </view>

    <!-- 2. 拍摄日期 -->
    <view class="card card-date">
      <view class="card-title">拍摄日期</view>
      <view class="grid2">
        <view>
          <view class="label">开始日期</view>
          <picker mode="date" value="{{d1}}" bindchange="onDate1">
            <view class="fv">{{d1}}</view>
          </picker>
        </view>
        <view>
          <view class="label">结束日期</view>
          <picker mode="date" value="{{d2}}" bindchange="onDate2">
            <view class="fv">{{d2}}</view>
          </picker>
        </view>
      </view>
      <view class="hint tiny">跨度上限 5 年</view>
    </view>

    <!-- 3. 目的地及出发地 -->
    <view class="card card-place">
      <view class="card-title">目的地及出发地</view>

      <view class="frow">
        <text class="flabel">目标地区</text>
        <picker mode="selector" range="{{regions}}" value="{{regionIndex}}" bindchange="onRegion">
          <view class="fv">{{regions[regionIndex]}}</view>
        </picker>
      </view>

      <view class="frow">
        <text class="flabel">目标省份</text>
        <picker mode="selector" range="{{provinces}}" range-key="label" value="{{provinceIndex}}" bindchange="onProvince">
          <view class="fv">{{provinces[provinceIndex].label}}</view>
        </picker>
      </view>

      <view class="frow">
        <text class="flabel">目标地点</text>
        <picker mode="selector" range="{{sites}}" range-key="label" value="{{siteIndex}}" bindchange="onSite" disabled="{{custom}}">
          <view class="fv">{{custom ? customLabel : sites[siteIndex].label}}</view>
        </picker>
      </view>

      <view class="frow">
        <text class="flabel">出发地点</text>
        <picker mode="selector" range="{{origins}}" range-key="label" value="{{originIndex}}" bindchange="onOrigin">
          <view class="fv">{{origins[originIndex].label}}</view>
        </picker>
      </view>

      <view class="map-row">
        <button class="btn map-btn" bindtap="openMap">🗺 地图选点</button>
        <button wx:if="{{custom}}" class="btn btn-ghost clear-btn" bindtap="clearCustom">清除</button>
      </view>
    </view>

    <view class="actions">
      <button class="btn" style="flex:1.4" bindtap="onSearch">查询</button>
      <button class="btn btn-ghost" style="flex:1" bindtap="onReset">重置</button>
    </view>
  </block>
</view>
