/* 紧凑布局：三组筛选 + 查询/重置 一屏可见 */
.wrap.compact { padding: 14rpx 18rpx 30rpx; }
.topbar { display: flex; align-items: baseline; gap: 12rpx; padding: 2rpx 4rpx 10rpx; }
.topbar-title { font-size: 34rpx; font-weight: 700; }
.topbar-sub { font-size: 22rpx; color: var(--dim); }

.card { padding: 12rpx 16rpx; margin-bottom: 10rpx; border-radius: 14rpx; }
.card-title { font-size: 26rpx; margin-bottom: 6rpx; }

.frow {
  display: grid; grid-template-columns: 210rpx minmax(0, 1fr);
  gap: 10rpx; align-items: center; padding: 6rpx 0;
}
.flabel { font-size: 24rpx; color: var(--dim); }
.fv {
  background: var(--panel-2); border: 1rpx solid var(--line); border-radius: 10rpx;
  padding: 10rpx 12rpx; font-size: 24rpx; line-height: 1.3;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; }
.actions { display: flex; gap: 12rpx; margin-top: 12rpx; }
.actions .btn { padding: 16rpx 0; font-size: 28rpx; }
.hint.tiny { font-size: 20rpx; margin-top: 6rpx; }
picker { display: block; }
.mini-btn {
  padding: 10rpx 0; font-size: 24rpx; border-radius: 10rpx;
  background: transparent; border: 1rpx solid var(--line); color: var(--text);
  line-height: 1.4;
}
