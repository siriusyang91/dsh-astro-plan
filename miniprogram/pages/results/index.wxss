/* 结果卡片：手机竖屏优先，不做横向滚动 */
.item { position: relative; }
.item-head { display: flex; align-items: baseline; justify-content: space-between; }
.item-title { display: flex; align-items: baseline; gap: 12rpx; }
.rank { color: var(--dim); font-size: 24rpx; }
.name { font-size: 32rpx; font-weight: 600; }
.score { font-size: 34rpx; color: var(--gold); font-weight: 600; }
.item-sub { color: var(--dim); font-size: 24rpx; margin-top: 6rpx; }
.item-weather { color: #8fd0a8; font-size: 24rpx; margin-top: 8rpx; }
.pager { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 24rpx 0 10rpx; }
.pager-btn { flex: 1; font-size: 26rpx; padding: 16rpx 0; }

.item-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.open-btn { color: var(--gold); font-size: 24rpx; padding: 6rpx 0 6rpx 16rpx; }

.loading {
  font-size: 30rpx;
  color: var(--gold);
  text-align: center;
  padding: 30rpx 0;
  animation: breathe 1.4s ease-in-out infinite;
}
@keyframes breathe {
  0%, 100% { opacity: .55; }
  50% { opacity: 1; }
}

.loading-wrap {
  position: relative;
  height: calc(100vh - 240rpx);
}
.loading {
  position: absolute;
  top: 26%;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--text);
}
.feed-block {
  position: absolute;
  top: 52%;
  left: 12rpx;
  right: 12rpx;
}
.feed-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-bottom: 10rpx;
  color: #cfe0f7;
  background: rgba(47, 102, 201, .22);
  border: 1rpx solid rgba(90, 140, 220, .45);
}
.feed-tag.hot { color: #ffd479; background: rgba(201, 138, 47, .18); border-color: rgba(255, 212, 121, .45); }
.feed-tag.news { color: #7ff0e2; background: rgba(47, 156, 156, .2); border-color: rgba(95, 224, 208, .45); }
.feed {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  padding: 26rpx 24rpx 30rpx;
  border-radius: 16rpx;
  border: 1rpx solid #1d3350;
  background: linear-gradient(135deg, #0b1424 0%, #101b2e 60%, #0d1830 100%);
  box-shadow: inset 0 1rpx 0 rgba(120, 170, 255, .08);
  overflow: hidden;
  transition: opacity 200ms ease, transform 200ms ease;
}
.feed::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(1rpx 1rpx at 12% 24%, rgba(255,255,255,.35) 50%, transparent 51%),
    radial-gradient(1rpx 1rpx at 68% 38%, rgba(255,255,255,.25) 50%, transparent 51%),
    radial-gradient(1rpx 1rpx at 84% 72%, rgba(255,255,255,.3) 50%, transparent 51%),
    radial-gradient(1rpx 1rpx at 32% 82%, rgba(255,255,255,.2) 50%, transparent 51%),
    radial-gradient(1rpx 1rpx at 52% 14%, rgba(255,255,255,.22) 50%, transparent 51%);
  pointer-events: none;
  opacity: .7;
}
.feed.fade-out { opacity: 0; transform: translateY(6rpx); }
.feed.fade-in { opacity: 1; transform: translateY(0); }
.feed-bar { width: 6rpx; border-radius: 4rpx; flex: 0 0 auto; }
.feed-bar.tip { background: linear-gradient(180deg, #4f8fe8, #2f66c9); }
.feed-bar.news { background: linear-gradient(180deg, #5fe0d0, #2f9c9c); }
.feed-bar.hot { background: linear-gradient(180deg, #ffd479, #c98a2f); }
.feed-body { flex: 1; min-width: 0; }
.feed-title { font-size: 28rpx; font-weight: 700; color: var(--gold); margin-bottom: 8rpx; }
.feed-text { font-size: 28rpx; line-height: 1.55; color: #cfe0f7; }
