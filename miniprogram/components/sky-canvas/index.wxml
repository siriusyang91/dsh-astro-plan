<view class="sky {{fullscreen ? 'full zoom-in' : ''}} {{justExited ? 'zoom-out' : ''}}" bindlongpress="onLongPress">
  <canvas
    id="sky"
    type="2d"
    class="cv {{fullscreen ? 'cv-full' : ''}}"
    bindtouchstart="onTouchStart"
    catchtouchmove="onTouchMove"
    bindtouchend="stop"
    bindlongpress="onLongPress"
  ></canvas>

  <!-- 全屏：顶部操作栏 -->
  <view wx:if="{{fullscreen}}" class="fs-top">
    <view class="key" bindtap="toggleMode">切换坐标系</view>
    <view class="key" bindtap="reset">复位视角</view>
    <view class="key" bindtap="toggleFullscreen">退出全屏</view>
  </view>

  <!-- 全屏：顶部信息栏（时间 / 视野 / 当前坐标系） -->
  <view wx:if="{{fullscreen}}" class="fs-info-top">
    <text class="fs-time">{{hud.time}}</text>
    <text class="fs-meta">{{hud.modeLabel}} · 视野 {{hud.fov}}</text>
  </view>

  <!-- 全屏：底部信息区（高度角 / 赤经赤纬 / 地点 / 最佳时段） -->
  <view wx:if="{{fullscreen}}" class="fs-info-bottom">
    <text class="fs-line">{{hud.altaz}}</text>
    <text class="fs-line">{{hud.radec}}</text>
    <text class="fs-line">{{hud.geo}}</text>
    <text class="fs-line">{{hud.window}}</text>
  </view>

  <!-- 全屏：底部操作栏（播放 + 进度条） -->
  <view wx:if="{{fullscreen}}" class="fs-bottom">
    <view class="key" bindtap="togglePlay">{{playing ? '暂停' : '播放'}}</view>
    <slider style="flex:1" min="0" max="{{maxK}}" value="{{k}}" block-size="14" bindchanging="onSlide" bindchange="onSlide" activeColor="#2f66c9" />
    <view class="frame">{{k}}/{{maxK}}</view>
  </view>

  <block wx:if="{{!fullscreen}}">
    <view class="tip">拖动转视角（左右转向 / 上下俯仰）· 双指缩放 · 长按全屏</view>
    <view class="ctrl">
      <view class="play" bindtap="togglePlay">{{playing ? '暂停' : '播放'}}</view>
      <slider style="flex:1" min="0" max="{{maxK}}" value="{{k}}" block-size="14" bindchanging="onSlide" bindchange="onSlide" activeColor="#2f66c9" />
      <view class="frame">{{k}}/{{maxK}}</view>
    </view>
    <view class="ctrl">
      <view class="key" bindtap="toggleMode">切换坐标系</view>
      <view class="key" bindtap="reset">复位视角</view>
      <view class="key" bindtap="toggleFullscreen">全屏显示</view>
      <view class="fov">视野 {{fovText}}</view>
    </view>
  </block>
</view>
