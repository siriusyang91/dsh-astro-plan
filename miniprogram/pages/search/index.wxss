/* 查询页：三组卡片（轻微色差）+ 一行一字段 + 与画面模拟同款滑块 */
.wrap { padding: 12rpx 18rpx 28rpx; }
.hero { padding: 0 4rpx 10rpx; }
.hero-line { display: flex; align-items: baseline; gap: 10rpx; }
.hero-title { font-size: 36rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-sub { font-size: 22rpx; color: var(--dim); }

.card { padding: 16rpx 18rpx; margin-bottom: 14rpx; border-radius: 14rpx; }
.card-title { font-size: 26rpx; margin-bottom: 6rpx; }
.card-target { background: linear-gradient(180deg, #101b2e 0%, #111826 100%); border-color: #1d3556; }
.card-date { background: linear-gradient(180deg, #141428 0%, #111826 100%); border-color: #2b2450; }
.card-place { background: linear-gradient(180deg, #0f1e22 0%, #111826 100%); border-color: #17434a; }

.frow {
  display: grid;
  grid-template-columns: max-content minmax(0, 1fr);
  gap: 2rpx;
  align-items: center;
  padding: 10rpx 0;
}
.flabel { font-size: 20rpx; line-height: 1.3; color: var(--dim); white-space: nowrap; }
.fv {
  background: var(--panel-2);
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  padding: 14rpx 12rpx;
  font-size: 24rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sl { flex: 1; min-width: 0; margin: 0; }
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.actions { display: flex; gap: 12rpx; margin-top: 18rpx; align-items: stretch; }
.reset-btn { flex: 0 0 150rpx; font-size: 24rpx; padding: 16rpx 0; }
.search-btn { flex: 1; font-size: 30rpx; padding: 20rpx 0; font-weight: 600; }
.hint.tiny { font-size: 20rpx; margin-top: 6rpx; }
.label { font-size: 22rpx; margin-bottom: 6rpx; }
picker { display: block; }
.map-row { display: flex; gap: 10rpx; margin-top: 12rpx; }
.map-btn {
  flex: 1;
  background: var(--accent);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-weight: 600;
}


.frow.target { padding: 10rpx 0 12rpx; }
.fv-lg { padding: 20rpx 16rpx; font-size: 28rpx; line-height: 1.35; border-radius: 12rpx; }

.hero-ver { font-size: 20rpx; color: var(--dim); border: 1rpx solid var(--line); border-radius: 999rpx; padding: 2rpx 12rpx; margin-left: 6rpx; }
