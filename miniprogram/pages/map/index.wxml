<view class="map-wrap">
  <map
    id="picker"
    class="map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    polyline="{{polyline}}"
    show-location="{{false}}"
    enable-zoom="{{true}}"
    enable-scroll="{{true}}"
    bindtap="onMapTap"
    bindmarkertap="onMarkerTap"
  ></map>

  <view class="panel">
    <view class="picked">{{selectedText}}</view>
    <view class="hint" wx:if="{{hint}}">{{hint}}</view>

    <view class="coord-row">
      <view class="coord-field">
        <view class="label">纬度</view>
        <input class="input" value="{{latText}}" placeholder="39.9042" bindinput="onLatInput" />
      </view>
      <view class="coord-field">
        <view class="label">经度</view>
        <input class="input" value="{{lonText}}" placeholder="116.4074" bindinput="onLonInput" />
      </view>
    </view>

    <view class="preset-row">
      <picker mode="selector" range="{{presets}}" range-key="label" value="{{presetIndex}}" bindchange="onPresetChange">
        <view class="preset-btn">选择预设地点 · {{presetLabel}}</view>
      </picker>
    </view>

    <view class="coord-btns">
      <button class="btn btn-ghost" style="flex:1" bindtap="onCancel">取消</button>
      <button class="btn" style="flex:1.4" bindtap="onConfirm">确定</button>
    </view>
    <view class="hint" wx:if="{{loading}}">正在加载 173 个预设站点…</view>
  </view>
</view>
